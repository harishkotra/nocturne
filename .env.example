# --- Inference: default is Particle.ai (OpenAI-compatible) ---
OPENAI_BASE_URL=https://api.particle.ai/v1
OPENAI_API_KEY=pa-xxxxxxxx
MODEL=deepseek-v4.1-flash

# --- Optional add-ons the Settings panel offers ---
LMSTUDIO_BASE_URL=http://localhost:1234/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=

# --- Letta ---
LETTA_BASE_URL=http://localhost:8283
LETTA_MODE=letta            # letta | sqlite (fallback)

# --- Retention policy defaults (overridable in the UI) ---
MAX_ACTIVE_FACTS=120
STALE_AFTER_DAYS=45
PROTECTED_CATEGORIES=identity,preferences,commitments
PORT=3001
